{
  "name": "actwill-desktop",
  "productName": "WillBuddy",
  "version": "0.15.0",
  "private": true,
  "description": "WillBuddy desktop AI workspace",
  "author": "Actwill",
  "license": "UNLICENSED",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "test:browser": "node --test tests/acceptance/browser-live.mjs",
    "test:workspace": "node --test tests/acceptance/workspace-live.mjs",
    "test:streaming": "node --test tests/acceptance/streaming-live.mjs",
    "vendor:renderer": "node ../scripts/vendor-desktop-renderer.mjs",
    "test:commands": "node --test tests/acceptance/commands-live.mjs",
    "test:runs": "node --test tests/acceptance/runs-live.mjs",
    "vendor:office": "node ../scripts/vendor-desktop-office.mjs",
    "test:documents": "node --test tests/acceptance/documents-live.mjs",
    "vendor:genoffice": "node ../scripts/vendor-genoffice.mjs"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "docx": "9.13.0",
    "dompurify": "3.4.17",
    "electron": "42.0.0",
    "electron-builder": "26.0.12",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jsdom": "^30.1.3",
    "marked": "18.1.1",
    "playwright-core": "1.56.1",
    "pptxgenjs": "4.0.1",
    "prettier": "3.6.2"
  },
  "build": {
    "appId": "com.actwill.desktop",
    "productName": "WillBuddy",
    "asar": true,
    "files": [
      "main.mjs",
      "preload.cjs",
      "core.mjs",
      "src/**",
      "runtime/**",
      "assets/**",
      "package.json",
      "main/**",
      "services/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "icon": "assets/app.icns",
      "entitlements": "installer/entitlements.mac.plist",
      "entitlementsInherit": "installer/entitlements.mac.plist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/app.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "assets/icon-512.png"
    },
    "artifactName": "WillBuddy-${version}-${os}-${arch}.${ext}"
  }
}
